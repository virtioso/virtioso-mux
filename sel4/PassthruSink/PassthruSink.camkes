#pragma once
#ifndef VIRTIOSO_MUX_SEL4_PASSTHRUSINK_CAMKES
#define VIRTIOSO_MUX_SEL4_PASSTHRUSINK_CAMKES


import <GetChar.idl4>;
import <PutChar.idl4>;
import <Batch.idl4>;
import <serial.camkes>;

component PassthruSink {
    control;
    provides PutChar processed_putchar;
    provides PutChar raw_putchar;
    provides Batch raw_batch;
    provides GetChar getchar;

    uses IOPort serial_port;

    composition {
        component Serial hw_serial;
        connection seL4HardwareIOPort serial_ioport(from serial_port, to hw_serial.serial);
    }

    configuration {
        hw_serial.serial_attributes <- serial_attributes;
    }
}

#endif /* VIRTIOSO_MUX_SEL4_PASSTHRUSINK_CAMKES */
